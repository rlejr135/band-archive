FLASK_APP=app.py
FLASK_ENV=development
DATABASE_URL=sqlite:///band_archive.db
SECRET_KEY=your-secret-key-here
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
NAVER_SEARCH_CLIENT_ID=your-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=your-naver-search-client-secret

# Supabase Auth (keep disabled until all production values are configured).
# Never put a Supabase service-role key or SMTP password in this file.
SUPABASE_AUTH_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
SUPABASE_JWKS_CACHE_SECONDS=300
SUPABASE_HTTP_TIMEOUT_SECONDS=5
SUPABASE_JWT_LEEWAY_SECONDS=30
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@example.com

# PostgreSQL only: keep both false during cutover. SQLite behavior is unchanged.
# Audio opt-in recovers stale jobs and processes the EXISTING backlog too;
# enabling it requires separate CPU/R2-processing approval, not just deploy approval.
PG_AUDIO_WORKER_ENABLED=false
# Multipart opt-in may update session state and abort expired provider uploads.
PG_MULTIPART_RECOVERY_ENABLED=false
